# Sanctions ontology.
#
# Status: stub. Populated during Phase 0 (pilot domain).
#
# Scope: SanctionedEntity, sanctioning body, designation date,
# alignment with the EU consolidated sanctions list schema.

@prefix fontem:   <http://data.fontem.eu/ontology#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .

<http://data.fontem.eu/ontology/sanctions>
    a owl:Ontology ;
    rdfs:label "Fontem sanctions ontology"@en ;
    owl:imports <http://data.fontem.eu/ontology> ;
    owl:versionInfo "0.0.1-draft" .

# TBox to be filled in during Phase 0. Pilot domain — first source
# to be ported end-to-end (Phase 2).
