# Core ontology — top-of-hierarchy classes and shared properties.
#
# Status: stub. Populated during Phase 0.
#
# Scope: Agent, Organisation, Person, Document, GeographicEntity,
# and the small set of properties common to most entities
# (hasName → rdfs:label, hasCountry → wdt:P17, hasIdentifier).
#
# Other domain TBoxes (procurement.ttl, corporate.ttl, etc.) import
# this file via owl:imports.

@prefix fontem:   <http://fontem.eu/ontology#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix wd:       <http://www.wikidata.org/entity/> .
@prefix wdt:      <http://www.wikidata.org/prop/direct/> .

<http://fontem.eu/ontology>
    a owl:Ontology ;
    rdfs:label "Fontem core ontology"@en ;
    rdfs:comment "Top of the class hierarchy and shared properties."@en ;
    owl:versionInfo "0.0.1-draft" .

# TBox to be filled in during Phase 0.
