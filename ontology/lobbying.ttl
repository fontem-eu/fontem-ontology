# Lobbying ontology.
#
# Status: stub. Populated during Phase 0.
#
# Scope: Lobbyist, lobby meetings, EU Transparency Register
# vocabulary.

@prefix fontem:   <http://data.fontem.eu/ontology#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix wd:       <http://www.wikidata.org/entity/> .

<http://data.fontem.eu/ontology/lobbying>
    a owl:Ontology ;
    rdfs:label "Fontem lobbying ontology"@en ;
    owl:imports <http://data.fontem.eu/ontology> ;
    owl:versionInfo "0.0.1-draft" .

